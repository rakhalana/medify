APP_NAME=Medify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://medify.onrender.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (Supabase PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=medify

# Koneksi chatbot read-only
CHAT_DB_HOST=
CHAT_DB_PORT=5432
CHAT_DB_ADMIN_USERNAME=chat_admin_ro
CHAT_DB_ADMIN_PASSWORD=
CHAT_DB_VENDOR_USERNAME=chat_vendor_ro
CHAT_DB_VENDOR_PASSWORD=

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- File Storage ---
FILESYSTEM_DISK=local

# AWS / S3 (Supabase Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@medify.test"
MAIL_FROM_NAME="Medify"

# --- Pembayaran Simulasi ---
PAYMENT_DRIVER=simulated

# --- LLM / Chatbot AI ---
CHATBOT_ENABLED=true
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
